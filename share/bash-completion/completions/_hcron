#!/usr/bin/env bash

#
# By default, some info will get printed when completing some commands.  To
# disable this, set HCRON_NO_COMPINFO to a non-empty value.
#
# To disable injection of descriptions into completion candidates, set the
# variable HCRON_NO_COMPDESC to a non-empty value.
#

_hcron(){
    local cur=${COMP_WORDS[COMP_CWORD]}
    local prev=${COMP_WORDS[COMP_CWORD-1]}
    if [[ ${cur} == -* ]] ; then
        COMPREPLY+=($(compgen -W "--debug --help -h" -- "${cur}"))
    fi

    case ${COMP_CWORD} in
        1)  _hcron_subcommands ; return ;;
        *)  case ${COMP_WORDS[1]} in
                activate) _hcron_activate ; return ;;
                conv) _hcron_conv ; return ;;
                doc) _hcron_doc ; return ;;
                get) _hcron_get ; return ;;
                list) _hcron_list ; return ;;
                run) _hcron_run ; return ;;
                reload|unload|show-log|version) return ;;
            esac ;;
    esac
}

_hcron_subcommands(){
    local -A desc=(
        [activate]="Run an hcron event right now"
        [conv]="Convert between hcron and crontab"
        [doc]="Generate HTML summary of your hcrons"
        [event]="Create/edit event file"
        [get]="Get hcron information"
        [list]="List loaded hcrons on this host $(hostname)"
        [reload]="Load crons in \$HOME/.hcron/$(hostname --fqdn)/events"
        [run]="Prints a log of what *would* run in a given interval"
        [show-log]="Show the log"
        [unload]="Unload events"
        [version]="Print version"
    )
    COMPREPLY=($(compgen -W "activate conv doc event get list reload run show-log unload version" -- "${cur}"))
    if ((${#COMPREPLY[@]} <= 1)) ; then
        return
    fi

    if [[ -n $HCRON_NO_COMPDESC ]] ; then
        return
    fi

    local i c max_c=0
    for c in ${COMPREPLY[@]}; do
        if ((${#c} > max_c)); then
            max_c=${#c}
        fi
    done
    for((i=0; i<${#COMPREPLY[@]}; i++)) ; do
        printf -v COMPREPLY[i] "%-${max_c}s (%s)" "${COMPREPLY[i]}" "${desc[${COMPREPLY[i]}]}"
    done
}

_hcron_compinfo(){
    if [[ -n $HCRON_NO_COMPINFO ]] ; then
        return
    fi
    printf "\nCOMPLETION INFO: %s\n%s%s" "$*" "${PS1@P}" "${COMP_LINE}"
}

_hcron_run(){
    case ${COMP_CWORD} in
        2)
            _hcron_compinfo "Arg should be a directory in \$HOME/.hcron/hcron-dev-*/events"
            if [[ -z ${cur} ]] ; then
                COMPREPLY=("$HOME/.hcron/$(hostname --fqdn)/events")
                return
            else
                _filedir
            fi
            ;;
        3|4)
            _hcron_compinfo "Arg should be a date as YYYYMMDD[HHMM]"
            ;;
    esac
}

_hcron_activate(){
    _hcron_event_names
}

_hcron_conv(){
    if _hcron_cmd_contains --to-events || _hcron_cmd_contains --to-crontab ; then
        _filedir
    else
        COMPREPLY+=($(compgen -W "--to-events --to-crontab" -- "${cur}"))
    fi
}

_hcron_doc(){
    # Because hcron doc --help is incorrect about '-c CONFIG FILE' being
    # optional, completion takes care of the user by ignoring what they have on
    # the command line and forcing -c /etc/hcron/hcron.conf
    if ! _hcron_cmd_contains "-c" ; then
        _hcron_compinfo "forcing '-c /etc/hcron/hcron.conf' because otherwise hcron fails without telling us why"
        COMPREPLY=("-c /etc/hcron/hcron.conf")
    elif [[ ${prev} == "-c" ]] ; then
        _hcron_compinfo "forcing '-c /etc/hcron/hcron.conf' because otherwise hcron fails without telling us why"
        COMPREPLY=("/etc/hcron/hcron.conf")
    else
        _hcron_compinfo "Arg should be a snapshot file or an events dir"
        _filedir
    fi
}

_hcron_get(){
    COMPREPLY+=($(compgen -W "allowed fqdn servername" -- "${cur}"))
}

_hcron_event(){
    if [[ ${cur} == -* ]] ; then
        COMPREPLY+=($(compgen -W "-c -y" -- "${cur}"))
    elif declare -f _filedir >/dev/null 2>&1 ; then
        _filedir
    fi
}

_hcron_list(){
    if [[ ${cur} == -* ]] ; then
        COMPREPLY+=($(compgen -W "--show-all --show-status" -- "${cur}"))
    else
        _hcron_event_names
    fi
}

_hcron_event_names(){
    while read event ; do
        name=${event##*:}
        if [[ ${name} == ${cur}* ]] ; then
            COMPREPLY+=(${name})
        fi
    done < <(hcron list --show-all 2>/dev/null)
}

_hcron_cmd_contains(){
    for cmd_word in ${COMP_WORDS[@]:1:${#COMP_WORDS[*]}-2} ; do
        if [[ ${cmd_word} == ${1} ]] ; then
            return 0
        fi
    done
    return 1
}

complete -F _hcron hcron
